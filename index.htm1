<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VOID GAMING</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:Arial,sans-serif;
  background:#050713;
  color:#fff;
  line-height:1.5;
}
a{text-decoration:none;color:inherit}

header{
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(5,7,19,.96);
  border-bottom:1px solid #25294b;
}

.nav{
  max-width:1200px;
  margin:auto;
  padding:15px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.logo{
  font-size:23px;
  font-weight:900;
  color:#a855f7;
}

.logo span{color:#fff}

.links{
  display:flex;
  gap:20px;
  color:#c6c8da;
  font-size:14px;
}

.links a:hover{color:#c084fc}

.button{
  display:inline-block;
  padding:12px 20px;
  border-radius:9px;
  background:linear-gradient(135deg,#7c3aed,#c026ff);
  color:white;
  font-weight:bold;
  border:0;
  cursor:pointer;
}

.hero{
  min-height:570px;
  display:flex;
  align-items:center;
  padding:80px 7%;
  background:
    radial-gradient(circle at 75% 35%,rgba(124,58,237,.45),transparent 30%),
    radial-gradient(circle at 20% 80%,rgba(192,38,255,.18),transparent 30%),
    linear-gradient(135deg,#070a18,#120629,#050713);
}

.hero-content{max-width:720px}

.kicker{
  color:#c084fc;
  letter-spacing:5px;
  font-size:13px;
  font-weight:bold;
  margin-bottom:15px;
}

h1{
  font-size:clamp(55px,9vw,100px);
  line-height:.9;
  margin-bottom:25px;
  font-style:italic;
}

h1 span{
  color:#a855f7;
  text-shadow:0 0 30px #8b5cf6;
}

.hero p{
  color:#c7c9da;
  max-width:650px;
  font-size:17px;
  margin-bottom:28px;
}

.buttons{
  display:flex;
  gap:14px;
  flex-wrap:wrap;
}

.secondary{
  display:inline-block;
  border:1px solid #7c3aed;
  padding:12px 20px;
  border-radius:9px;
  font-weight:bold;
}

.tagline{
  margin-top:28px;
  color:#b86cff;
  letter-spacing:3px;
  font-size:12px;
}

.container{
  max-width:1200px;
  margin:auto;
  padding:55px 20px;
}

.section-title{
  font-size:30px;
  margin-bottom:22px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:16px;
}

.card{
  background:linear-gradient(145deg,#0b1022,#080b18);
  border:1px solid #26305a;
  border-radius:14px;
  padding:25px 18px;
  text-align:center;
  transition:.25s;
}

.card:hover{
  transform:translateY(-5px);
  border-color:#a855f7;
  box-shadow:0 0 25px rgba(168,85,247,.18);
}

.icon{
  font-size:40px;
  margin-bottom:12px;
}

.card h3{margin-bottom:8px}
.card p{color:#9ea5c2;font-size:13px}

.dashboard{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:18px;
}

.panel{
  background:#090e1e;
  border:1px solid #26305a;
  border-radius:14px;
  padding:22px;
}

.panel h2{
  margin-bottom:18px;
  font-size:20px;
}

.server-box{
  padding:15px;
  background:#0d1428;
  border-radius:10px;
  margin-bottom:14px;
}

.server-box p{
  color:#aab1ca;
  margin:7px 0;
}

.online{
  color:#22c55e;
  font-weight:bold;
}

.ip{
  color:#c084fc;
  font-weight:bold;
  word-break:break-all;
}

.join{
  display:block;
  text-align:center;
  margin-top:15px;
}

input{
  width:100%;
  padding:13px;
  background:#050817;
  border:1px solid #30385d;
  border-radius:8px;
  color:white;
  margin-bottom:12px;
  outline:none;
}

input:focus{border-color:#a855f7}

.stat{
  display:flex;
  justify-content:space-between;
  padding:10px 0;
  border-bottom:1px solid #202744;
}

.stat span:last-child{
  color:#c084fc;
  font-weight:bold;
}

.player{
  display:flex;
  justify-content:space-between;
  padding:12px 0;
  border-bottom:1px solid #202744;
}

.rank{
  color:#facc15;
  font-weight:bold;
}

.small{
  color:#8f96b3;
  font-size:12px;
}

.cta{
  margin:20px;
  padding:50px 25px;
  text-align:center;
  border:1px solid #7c3aed;
  border-radius:18px;
  background:radial-gradient(circle,#26104c,#090b18);
}

.cta h2{
  font-size:35px;
  margin-bottom:10px;
}

.cta p{
  color:#aeb4ca;
  margin-bottom:22px;
}

footer{
  text-align:center;
  padding:35px 20px;
  color:#777f9d;
  border-top:1px solid #202744;
}

footer strong{color:#a855f7}

@media(max-width:900px){
  .grid{grid-template-columns:repeat(2,1fr)}
  .dashboard{grid-template-columns:1fr}
  .links{display:none}
}

@media(max-width:500px){
  .grid{grid-template-columns:1fr}
  .hero{padding:65px 22px}
  h1{font-size:58px}
  .hero p{font-size:15px}
}
</style>
</head>

<body>

<header>
<div class="nav">

<div class="logo">
VOID <span>GAMING</span>
</div>

<div class="links">
<a href="#home">Home</a>
<a href="#games">Games</a>
<a href="#stats">Stats</a>
<a href="#leaderboard">Leaderboard</a>
<a href="#server">Server</a>
</div>

<a class="button" href="#community">Join Now</a>

</div>
</header>


<section class="hero" id="home">

<div class="hero-content">

<div class="kicker">WELCOME TO</div>

<h1>
VOID <span>GAMING</span>
</h1>

<p>
The ultimate gaming hub for Minecraft, Lifesteal SMP,
leaderboards, player stats, achievements and community.
</p>

<div class="buttons">
<a class="button" href="#server">🎮 PLAY NOW</a>
<a class="secondary" href="#community">💬 JOIN COMMUNITY</a>
</div>

<div class="tagline">
PLAY • COMPETE • ACHIEVE • BE LEGENDARY
</div>

</div>
</section>


<section class="container" id="games">

<h2 class="section-title">🎮 Gaming Hub</h2>

<div class="grid">

<div class="card">
<div class="icon">⛏️</div>
<h3>Minecraft</h3>
<p>Build, explore and survive.</p>
</div>

<div class="card">
<div class="icon">❤️</div>
<h3>Lifesteal SMP</h3>
<p>Fight and collect hearts.</p>
</div>

<div class="card">
<div class="icon">🏆</div>
<h3>Leaderboards</h3>
<p>Compete for the top.</p>
</div>

<div class="card">
<div class="icon">👤</div>
<h3>Player Stats</h3>
<p>Track your progress.</p>
</div>

<div class="card">
<div class="icon">👥</div>
<h3>Community</h3>
<p>Meet other gamers.</p>
</div>

</div>
</section>


<section class="container" id="server">

<h2 class="section-title">⚡ Server Dashboard</h2>

<div class="dashboard">

<div class="panel">

<h2>🟢 Server Status</h2>

<div class="server-box">
<p>Status: <span class="online">ONLINE</span></p>
<p>Server: <span class="ip">play.voidgaming.net</span></p>
<p>Mode: Lifesteal SMP</p>
<p>Players: 128 / 500</p>
</div>

<a class="button join" href="#community">
JOIN SERVER
</a>

</div>


<div class="panel" id="stats">

<h2>👤 Player Stats</h2>

<input
id="playerInput"
type="text"
placeholder="Enter player name..."
>

<button class="button" onclick="showStats()">
SEARCH
</button>

<div id="statsResult" style="margin-top:15px">

<div class="stat">
<span>Hearts</span>
<span>30 ❤️</span>
</div>

<div class="stat">
<span>Kills</span>
<span>245</span>
</div>

<div class="stat">
<span>Deaths</span>
<span>31</span>
</div>

<div class="stat">
<span>Rank</span>
<span>VOID</span>
</div>

</div>

</div>


<div class="panel" id="leaderboard">

<h2>🏆 Top Players</h2>

<div class="player">
<span><span class="rank">#1</span> Shadow</span>
<strong>85 ❤️</strong>
</div>

<div class="player">
<span><span class="rank">#2</span> VoidKing</span>
<strong>72 ❤️</strong>
</div>

<div class="player">
<span><span class="rank">#3</span> Dragon</span>
<strong>64 ❤️</strong>
</div>

<div class="player">
<span><span class="rank">#4</span> Blaze</span>
<strong>58 ❤️</strong>
</div>

<div class="player">
<span><span class="rank">#5</span> Ninja</span>
<strong>51 ❤️</strong>
</div>

</div>

</div>
</section>


<section class="cta" id="community">

<h2>READY TO ENTER THE VOID?</h2>

<p>
Join the VOID GAMING community and start your journey.
</p>

<a class="button" href="https://discord.com" target="_blank">
💬 JOIN DISCORD
</a>

</section>


<footer>

<p>
<strong>VOID GAMING</strong>
</p>

<p class="small">
Minecraft • Lifesteal • Community • Leaderboards
</p>

<p class="small">
© 2026 VOID GAMING. All rights reserved.
</p>

</footer>


<script>
function showStats(){

const name =
document.getElementById("playerInput").value.trim();

const result =
document.getElementById("statsResult");

if(name === ""){
result.innerHTML =
"<p class='small'>Please enter a player name.</p>";
return;
}

result.innerHTML = `
<p style="margin-bottom:10px">
Stats for <strong>${name}</strong>
</p>

<div class="stat">
<span>Hearts</span>
<span>30 ❤️</span>
</div>

<div class="stat">
<span>Kills</span>
<span>245</span>
</div>

<div class="stat">
<span>Deaths</span>
<span>31</span>
</div>

<div class="stat">
<span>Rank</span>
<span>VOID</span>
</div>
`;
}
</script>

</body>
</html>
